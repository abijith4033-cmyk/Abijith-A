#include <stdlib.h>
#include <limits.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define MIN(a, b) ((a) < (b) ? (a) : (b))

int maximumGap(int* nums, int numsSize) {
    // Return 0 if the array contains fewer than 2 elements
    if (nums == NULL || numsSize < 2) {
        return 0;
    }

    // Step 1: Find the global minimum and maximum values
    int min_val = INT_MAX;
    int max_val = INT_MIN;
    for (int i = 0; i < numsSize; i++) {
        min_val = MIN(min_val, nums[i]);
        max_val = MAX(max_val, nums[i]);
    }

    // If all elements are identical, the maximum gap is 0
    if (min_val == max_val) {
        return 0;
    }

    // Step 2: Determine bucket size and bucket count
    // Gap size must be at least 1
    int bucket_size = MAX(1, (max_val - min_val) / (numsSize - 1));
    int bucket_count = (max_val - min_val) / bucket_size + 1;

    // Step 3: Allocate and initialize bucket structures
    int* bucket_min = (int*)malloc(bucket_count * sizeof(int));
    int* bucket_max = (int*)malloc(bucket_count * sizeof(int));
    int* bucket_has_elements = (int*)calloc(bucket_count, sizeof(int));

    for (int i = 0; i < bucket_count; i++) {
        bucket_min[i] = INT_MAX;
        bucket_max[i] = INT_MIN;
    }

    // Step 4: Map each element into its respective bucket
    for (int i = 0; i < numsSize; i++) {
        int idx = (nums[i] - min_val) / bucket_size;
        bucket_min[idx] = MIN(bucket_min[idx], nums[i]);
        bucket_max[idx] = MAX(bucket_max[idx], nums[i]);
        bucket_has_elements[idx] = 1;
    }

    // Step 5: Calculate the maximum gap between consecutive non-empty buckets
    int max_gap = 0;
    int prev_max = min_val; // Tracks the max value of the previous non-empty bucket

    for (int i = 0; i < bucket_count; i++) {
        if (!bucket_has_elements[i]) {
            continue;
        }
        // Gap is the difference between current bucket min and previous bucket max
        max_gap = MAX(max_gap, bucket_min[i] - prev_max);
        prev_max = bucket_max[i];
    }

    // Step 6: Free dynamically allocated memory
    free(bucket_min);
    free(bucket_max);
    free(bucket_has_elements);

    return max_gap;
}
