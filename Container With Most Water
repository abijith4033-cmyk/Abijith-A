int maxArea(int* height, int heightSize) {
    int max_water = 0;
    int left = 0;
    int right = heightSize - 1;
    
    // Loop until the two pointers meet
    while (left < right) {
        // 1. Find the width of the container
        int width = right - left;
        
        // 2. Find the shorter line (which limits the water height)
        int current_height = (height[left] < height[right]) ? height[left] : height[right];
        
        // 3. Calculate current water volume
        int current_water = width * current_height;
        
        // 4. Update the maximum water found so far
        if (current_water > max_water) {
            max_water = current_water;
        }
        
        // 5. Move the pointer pointing to the shorter line inward
        if (height[left] < height[right]) {
            left++;
        } else {
            right--;
        }
    }
    
    return max_water;
}
