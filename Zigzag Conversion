#include <stdlib.h>
#include <string.h>

char* convert(char* s, int numRows) {
    // 1. Edge cases: If numRows is 1 or the string is too short, 
    // the zigzag pattern is identical to the original string.
    if (numRows <= 1 || s == NULL || s[0] == '\0') {
        int len = strlen(s);
        char* result = (char*)malloc((len + 1) * sizeof(char));
        strcpy(result, s);
        return result;
    }

    int len = strlen(s);
    char* result = (char*)malloc((len + 1) * sizeof(char));
    int count = 0;

    // The cycle size determines the jump distance to the next character in the same row slot
    int cycleLen = 2 * numRows - 2;

    // 2. Process the characters row by row
    for (int r = 0; r < numRows; r++) {
        for (int i = r; i < len; i += cycleLen) {
            // Append the primary character of the vertical column down down step
            result[count++] = s[i];

            // 3. For inner rows (not the top or bottom row), 
            // compute and insert the diagonal "zag" character if it exists
            if (r > 0 && r < numRows - 1) {
                int diagonalIdx = i + cycleLen - 2 * r;
                if (diagonalIdx < len) {
                    result[count++] = s[diagonalIdx];
                }
            }
        }
    }

    // 4. Manually close the heap block with a null terminator
    result[count] = '\0';
    return result;
}
