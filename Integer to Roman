#include <stdlib.h>
#include <string.h>

char* intToRoman(int num) {
    // 1. Map Roman numeral symbols and their corresponding values in descending order
    int values[]     = {1000, 900,  500, 400,  100, 90,   50,  40,   10,  9,   5,   4,   1};
    char* symbols[]  = {"M",  "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
    
    // Allocate memory for the result string
    // The longest Roman numeral string under 4000 is "MMMCMXCVIII" (3988), which is 15 chars + '\0'
    char* roman = (char*)malloc(16 * sizeof(char));
    roman[0] = '\0'; // Initialize as an empty string
    
    // 2. Loop through the values table and subtract greedily
    for (int i = 0; i < 13; i++) {
        while (num >= values[i]) {
            strcat(roman, symbols[i]);
            num -= values[i];
        }
    }
    
    return roman;
}
