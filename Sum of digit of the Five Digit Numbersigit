#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    
    int n;
    scanf("%d", &n);
    
    int sum = 0;
    
    // Process each digit using a loop until the number becomes 0
    while (n > 0) {
        sum += n % 10;  // Extract the last digit and add it to sum
        n = n / 10;     // Remove the last digit from the number
    }
    
    // Print the calculated sum of the digits
    printf("%d\n", sum);
    
    return 0;
}
