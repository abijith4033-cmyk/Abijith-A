#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_STRING_LENGTH 6

struct package
{
    char* id;
    int weight;
};

typedef struct package package;

struct post_office
{
    int min_weight;
    int max_weight;
    package* packages;
    int packages_count;
};

typedef struct post_office post_office;

struct town
{
    char* name;
    post_office* offices;
    int offices_count;
};

typedef struct town town;

// --- Implemented Functions ---

// 1. Prints the town name followed by all packages in each of its post offices
void print_all_packages(town t) {
    printf("%s:\n", t.name);
    for (int i = 0; i < t.offices_count; i++) {
        printf("\t%d:\n", i);
        for (int j = 0; j < t.offices[i].packages_count; j++) {
            printf("\t\t%s\n", t.offices[i].packages[j].id);
        }
    }
}

// 2. Transfers valid packages from a source office to a target office based on weight limits
void send_all_acceptable_packages(town* source, int source_office_index, town* target, int target_office_index) {    
    post_office* src_office = &source->offices[source_office_index];
    post_office* tgt_office = &target->offices[target_office_index];

    // Temporary arrays to track which packages move and which stay
    package* accepted = malloc(sizeof(package) * src_office->packages_count);
    package* rejected = malloc(sizeof(package) * src_office->packages_count);
    
    int accepted_count = 0;
    int rejected_count = 0;

    // Sort source packages into accepted (target's limits) or rejected (remain in source)
    for (int i = 0; i < src_office->packages_count; i++) {
        int w = src_office->packages[i].weight;
        if (w >= tgt_office->min_weight && w <= tgt_office->max_weight) {
            accepted[accepted_count++] = src_office->packages[i];
        } else {
            rejected[rejected_count++] = src_office->packages[i];
        }
    }

    // If any packages are transferred, expand the target office package array
    if (accepted_count > 0) {
        tgt_office->packages = realloc(tgt_office->packages, sizeof(package) * (tgt_office->packages_count + accepted_count));
        for (int i = 0; i < accepted_count; i++) {
            tgt_office->packages[tgt_office->packages_count + i] = accepted[i];
        }
        tgt_office->packages_count += accepted_count;
    }

    // Update the source office with only the rejected packages
    free(src_office->packages);
    if (rejected_count > 0) {
        src_office->packages = malloc(sizeof(package) * rejected_count);
        for (int i = 0; i < rejected_count; i++) {
            src_office->packages[i] = rejected[i];
        }
        src_office->packages_count = rejected_count;
    } else {
        src_office->packages = NULL;
        src_office->packages_count = 0;
    }

    // Clean up temporary tracking arrays
    free(accepted);
    free(rejected);
}

// 3. Finds and returns the town structure containing the highest total packages across all its offices
town town_with_most_packages(town* towns, int towns_count) {
    town max_town = towns[0];
    int max_packages = 0;

    // Calculate initial count for the first town
    for (int j = 0; j < towns[0].offices_count; j++) {
        max_packages += towns[0].offices[j].packages_count;
    }

    // Compare with all other towns
    for (int i = 1; i < towns_count; i++) {
        int current_packages = 0;
        for (int j = 0; j < towns[i].offices_count; j++) {
            current_packages += towns[i].offices[j].packages_count;
        }
        if (current_packages > max_packages) {
            max_packages = current_packages;
            max_town = towns[i];
        }
    }
    return max_town;
}

// 4. Searches through the towns array and returns a pointer to the matching town name
town* find_town(town* towns, int towns_count, char* name) {
    for (int i = 0; i < towns_count; i++) {
        if (strcmp(towns[i].name, name) == 0) {
            return &towns[i];
        }
    }
    return NULL;
}

// --- Given Main Routine ---
int main()
{
    int towns_count;
    if (scanf("%d", &towns_count) != 1) return 0;
    town* towns = malloc(sizeof(town)*towns_count);
    for (int i = 0; i < towns_count; i++) {
        towns[i].name = malloc(sizeof(char) * MAX_STRING_LENGTH);
        scanf("%s", towns[i].name);
        scanf("%d", &towns[i].offices_count);
        towns[i].offices = malloc(sizeof(post_office)*towns[i].offices_count);
        for (int j = 0; j < towns[i].offices_count; j++) {
            scanf("%d%d%d", &towns[i].offices[j].packages_count, &towns[i].offices[j].min_weight, &towns[i].offices[j].max_weight);
            towns[i].offices[j].packages = malloc(sizeof(package)*towns[i].offices[j].packages_count);
            for (int k = 0; k < towns[i].offices[j].packages_count; k++) {
                towns[i].offices[j].packages[k].id = malloc(sizeof(char) * MAX_STRING_LENGTH);
                scanf("%s", towns[i].offices[j].packages[k].id);
                scanf("%d", &towns[i].offices[j].packages[k].weight);
            }
        }
    }
    int queries;
    if (scanf("%d", &queries) != 1) return 0;
    char town_name[MAX_STRING_LENGTH];
    while (queries--) {
        int type;
        scanf("%d", &type);
        switch (type) {
        case 1:
            scanf("%s", town_name);
            town* t = find_town(towns, towns_count, town_name);
            if (t) print_all_packages(*t);
            break;
        case 2:
            scanf("%s", town_name);
            town* source = find_town(towns, towns_count, town_name);
            int source_index;
            scanf("%d", &source_index);
            scanf("%s", town_name);
            town* target = find_town(towns, towns_count, town_name);
            int target_index;
            scanf("%d", &target_index);
            if (source && target) {
                send_all_acceptable_packages(source, source_index, target, target_index);
            }
            break;
        case 3:
            printf("Town with the most number of packages is %s\n", town_with_most_packages(towns, towns_count).name);
            break;
        }
    }
    return 0;
}
