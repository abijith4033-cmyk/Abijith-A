#include <stdlib.h>
#include <string.h>

char* longestCommonPrefix(char** strs, int strsSize) {
    // Edge case: if the array is empty, return an empty string
    if (strsSize == 0) {
        char* empty = (char*)malloc(sizeof(char));
        empty[0] = '\0';
        return empty;
    }

    // Iterate through each character of the first string
    for (int i = 0; strs[0][i] != '\0'; i++) {
        char c = strs[0][i];
        
        // Compare this character with the same position in all other strings
        for (int j = 1; j < strsSize; j++) {
            // If we reach the end of any string or find a mismatch
            if (strs[j][i] == '\0' || strs[j][i] != c) {
                // Allocate memory up to the current index plus null terminator
                char* result = (char*)malloc((i + 1) * sizeof(char));
                strncpy(result, strs[0], i);
                result[i] = '\0'; // Properly null-terminate
                return result;
            }
        }
    }

    // If the entire first string is the common prefix
    int len = strlen(strs[0]);
    char* result = (char*)malloc((len + 1) * sizeof(char));
    strcpy(result, strs[0]);
    return result;
}
