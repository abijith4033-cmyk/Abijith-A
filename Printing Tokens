#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {

    char *s;
    s = malloc(1024 * sizeof(char));
    if (scanf("%[^\n]", s) != 1) {
        free(s);
        return 0;
    }
    s = realloc(s, strlen(s) + 1);
    
    // Write your logic to print the tokens of the sentence here.
    for (int i = 0; s[i] != '\0'; i++) {
        if (s[i] == ' ') {
            printf("\n");
        } else {
            printf("%c", s[i]);
        }
    }
    printf("\n"); // Final trailing newline
    
    free(s);
    return 0;
}
