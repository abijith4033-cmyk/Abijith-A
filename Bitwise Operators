#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

// Complete the following function.
void calculate_the_maximum(int n, int k) {
    int max_and = 0;
    int max_or = 0;
    int max_xor = 0;

    // Nested loops to compare every unique pair (i, j) where 1 <= i < j <= n
    for (int i = 1; i < n; i++) {
        for (int j = i + 1; j <= n; j++) {
            
            // Calculate bitwise AND
            int current_and = i & j;
            if (current_and > max_and && current_and < k) {
                max_and = current_and;
            }

            // Calculate bitwise OR
            int current_or = i | j;
            if (current_or > max_or && current_or < k) {
                max_or = current_or;
            }

            // Calculate bitwise XOR
            int current_xor = i ^ j;
            if (current_xor > max_xor && current_xor < k) {
                max_xor = current_xor;
            }
        }
    }

    // Print the maximum values found
    printf("%d\n", max_and);
    printf("%d\n", max_or);
    printf("%d\n", max_xor);
}

int main() {
    int n, k;
  
    scanf("%d %d", &n, &k);
    calculate_the_maximum(n, k);
 
    return 0;
}

