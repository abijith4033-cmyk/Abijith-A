#include <limits.h>

// Helper macros to find maximum and minimum values
#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define MIN(a, b) ((a) < (b) ? (a) : (b))

double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    // 1. Ensure nums1 is always the smaller array.
    // This guarantees the binary search runs in O(log(min(m, n))) time.
    if (nums1Size > nums2Size) {
        return findMedianSortedArrays(nums2, nums2Size, nums1, nums1Size);
    }

    int m = nums1Size;
    int n = nums2Size;
    int low = 0;
    int high = m;

    // 2. Perform Binary Search on the smaller array
    while (low <= high) {
        int partitionX = low + (high - low) / 2;
        int partitionY = (m + n + 1) / 2 - partitionX;

        // If partitionX is 0, it means nothing is on the left side of nums1. Use INT_MIN.
        // If partitionX is m, it means nothing is on the right side of nums1. Use INT_MAX.
        int maxLeftX = (partitionX == 0) ? INT_MIN : nums1[partitionX - 1];
        int minRightX = (partitionX == m) ? INT_MAX : nums1[partitionX];

        // Do the same boundary checking for nums2
        int maxLeftY = (partitionY == 0) ? INT_MIN : nums2[partitionY - 1];
        int minRightY = (partitionY == n) ? INT_MAX : nums2[partitionY];

        // 3. Check if we have partitioned the arrays at the correct spot
        if (maxLeftX <= minRightY && maxLeftY <= minRightX) {
            // If the total number of elements across both arrays is odd
            if ((m + n) % 2 != 0) {
                return (double)MAX(maxLeftX, maxLeftY);
            }
            // If the total number of elements across both arrays is even
            return ((double)MAX(maxLeftX, maxLeftY) + MIN(minRightX, minRightY)) / 2.0;
        } 
        // We are too far right in nums1, move the search partition leftward
        else if (maxLeftX > minRightY) {
            high = partitionX - 1;
        } 
        // We are too far left in nums1, move the search partition rightward
        else {
            low = partitionX + 1;
        }
    }

    return 0.0;
}
