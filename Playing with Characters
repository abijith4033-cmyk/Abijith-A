#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() 
{
    char ch;
    char s[100];
    char sen[100];

    /* 1. Read the character */
    scanf("%c", &ch);

    /* 2. Read the string (stops at the first space or newline) */
    scanf("%s", s);

    /* 3. Read the sentence (the leading space consumes the leftover newline) */
    scanf(" %[^\n]%*c", sen);

    /* 4. Print the outputs */
    printf("%c\n", ch);
    printf("%s\n", s);
    printf("%s\n", sen);
    
    return 0;
}
