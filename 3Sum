#include <stdlib.h>

// Helper comparison function for qsort
int compare(const void* a, const void* b) { return (*(int*)a - *(int*)b); }

int** threeSum(int* nums, int numsSize, int* returnSize,
               int** returnColumnSizes) {
    // 1. Initialize returns to 0 in case no triplets are found
    *returnSize = 0;

    if (numsSize < 3) {
        *returnColumnSizes = NULL;
        return NULL;
    }

    // 2. Sort the array to easily handle duplicates and use two pointers
    qsort(nums, numsSize, sizeof(int), compare);

    // Initial allocation estimate for result arrays (will resize dynamically if
    // needed)
    int capacity = 16;
    int** result = (int**)malloc(capacity * sizeof(int*));
    *returnColumnSizes = (int*)malloc(capacity * sizeof(int));

    // 3. Iterate through the array up to the third-to-last element
    for (int i = 0; i < numsSize - 2; i++) {
        // Skip duplicate values for the first element of the triplet
        if (i > 0 && nums[i] == nums[i - 1]) {
            continue;
        }

        // Optimization: If the smallest number is greater than 0,
        // no combination can sum up to 0 since the array is sorted.
        if (nums[i] > 0) {
            break;
        }

        int left = i + 1;
        int right = numsSize - 1;

        // 4. Two-pointer search for the remaining two elements
        while (left < right) {
            int sum = nums[i] + nums[left] + nums[right];

            if (sum < 0) {
                left++; // Sum is too small, move left pointer rightward
            } else if (sum > 0) {
                right--; // Sum is too large, move right pointer leftward
            } else {
                // Triplet found! Expand capacity if needed
                if (*returnSize >= capacity) {
                    capacity *= 2;
                    result = (int**)realloc(result, capacity * sizeof(int*));
                    *returnColumnSizes = (int*)realloc(*returnColumnSizes,
                                                       capacity * sizeof(int));
                }

                // Allocate memory for the triplet
                result[*returnSize] = (int*)malloc(3 * sizeof(int));
                result[*returnSize][0] = nums[i];
                result[*returnSize][1] = nums[left];
                result[*returnSize][2] = nums[right];

                // Each triplet has exactly 3 columns
                (*returnColumnSizes)[*returnSize] = 3;
                (*returnSize)++;

                // Advance pointers and bypass duplicate elements
                while (left < right && nums[left] == nums[left + 1])
                    left++;
                while (left < right && nums[right] == nums[right - 1])
                    right--;

                left++;
                right--;
            }
        }
    }

    return result;
}
