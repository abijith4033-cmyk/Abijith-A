void sort_by_area(triangle* tr, int n) {
    /**
    * Sort an array a of the length n
    */
    // Dynamically allocate an array to store the calculated areas
    double* areas = malloc(n * sizeof(double));
    
    // Calculate the area for each triangle using Heron's Formula
    for (int i = 0; i < n; i++) {
        double p = (tr[i].a + tr[i].b + tr[i].c) / 2.0; // semi-perimeter
        // Heron's Formula: Area = sqrt(p * (p - a) * (p - b) * (p - c))
        areas[i] = sqrt(p * (p - tr[i].a) * (p - tr[i].b) * (p - tr[i].c));
    }
    
    // Bubble Sort algorithm to sort both areas and the triangles together
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (areas[j] > areas[j + 1]) {
                // Swap the areas
                double temp_area = areas[j];
                areas[j] = areas[j + 1];
                areas[j + 1] = temp_area;
                
                // Swap the actual triangle structures to match the sorted areas
                triangle temp_tr = tr[j];
                tr[j] = tr[j + 1];
                tr[j + 1] = temp_tr;
            }
        }
    }
    
    // Free the dynamically allocated memory
    free(areas);
}

