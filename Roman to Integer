#include <string.h>

// Helper function to return the integer value of a Roman numeral character
int getRomanValue(char c) {
    switch (c) {
        case 'I': return 1;
        case 'V': return 5;
        case 'X': return 10;
        case 'L': return 50;
        case 'C': return 100;
        case 'D': return 500;
        case 'M': return 1000;
        default:  return 0;
    }
}

int romanToInt(char* s) {
    int total = 0;
    
    // Loop through the string until the null-terminator
    for (int i = 0; s[i] != '\0'; i++) {
        int currentVal = getRomanValue(s[i]);
        int nextVal = getRomanValue(s[i + 1]); // Safe because s[i+1] will be '\0' (0) at the end

        // If the current value is less than the next value, subtract it
        if (currentVal < nextVal) {
            total -= currentVal;
        } 
        // Otherwise, add it to the total
        else {
            total += currentVal;
        }
    }
    
    return total;
}
