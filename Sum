int canCompleteCircuit(int* gas, int gasSize, int* cost, int costSize) {
    int total_tank = 0;   // Tracks net gas balance for the entire trip
    int current_tank = 0; // Tracks net gas balance from the current starting point
    int start_station = 0;

    for (int i = 0; i < gasSize; i++) {
        int net_fuel = gas[i] - cost[i];
        total_tank += net_fuel;
        current_tank += net_fuel;

        // If tank drops below 0, we cannot reach the next station from start_station
        if (current_tank < 0) {
            // Pick the next station as the new candidate start point
            start_station = i + 1;
            // Reset our tracking tank for the new candidate path
            current_tank = 0;
        }
    }

    // If overall net fuel is negative, a full loop is impossible
    return (total_tank >= 0) ? start_station : -1;
}
